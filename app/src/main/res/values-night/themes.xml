<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark-mode variant of the overflow popup theme. Same color overrides as
         the light version, but a Dark parent so the popup surface is dark.
         Color resources resolve to the values-night palette automatically. -->
    <style name="ThemeOverlay.WifiScanner.PopupMenu" parent="ThemeOverlay.Material3.Dark">
        <item name="android:colorBackground">@color/surface_elevated</item>
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="popupMenuStyle">@style/Widget.WifiScanner.PopupMenu</item>
    </style>
</resources>
