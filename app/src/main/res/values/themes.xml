<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WifiScanner" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/charcoal_focus</item>
        <item name="colorOnPrimary">@color/charcoal_background</item>
        <item name="colorPrimaryContainer">@color/brand</item>
        <item name="colorOnPrimaryContainer">@color/text_on_brand</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/charcoal_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg</item>

        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowSplashScreenBackground">@color/charcoal_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:textColorPrimary">@color/charcoal_text_states</item>
        <item name="android:textColorSecondary">@color/charcoal_secondary</item>
        <item name="android:textColorHighlight">@color/charcoal_selection</item>
        <item name="colorError">@color/charcoal_error</item>
        <item name="colorOnError">@color/charcoal_background</item>

        <item name="popupMenuStyle">@style/Widget.WifiScanner.PopupMenu</item>
        <item name="materialButtonStyle">@style/Widget.WifiScanner.Button</item>
    </style>

    <!-- Terminal-green variant: green brand on neutral black/white surfaces. -->
    <style name="Theme.WifiScanner.Green" parent="Theme.WifiScanner">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorPrimaryContainer">@color/brand_green</item>
        <item name="colorOnPrimaryContainer">@color/charcoal_background</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorSurface">@color/surface_green</item>
        <item name="colorSurfaceVariant">@color/surface_variant_green</item>
        <item name="colorOutline">@color/divider_green</item>
        <item name="android:colorBackground">@color/bg_green</item>
        <item name="android:windowBackground">@color/bg_green</item>
        <item name="android:navigationBarColor">@color/bg_green</item>
        <item name="android:statusBarColor">@color/brand_green_dark</item>
    </style>

    <style name="Widget.WifiScanner.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@color/surface_elevated</item>
    </style>

    <!-- Theme for the toolbar overflow popup. The toolbar uses a Dark ActionBar
         overlay for white icons; without an explicit popupTheme the dropdown
         would inherit that overlay and render washed-out text in light mode.
         Parent is Light here and Dark in values-night/themes.xml so the popup
         surface matches the active mode; color overrides reference DayNight
         resources. -->
    <style name="ThemeOverlay.WifiScanner.PopupMenu" parent="ThemeOverlay.Material3.Dark">
        <item name="android:colorBackground">@color/surface_elevated</item>
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="popupMenuStyle">@style/Widget.WifiScanner.PopupMenu</item>
    </style>

    <style name="Widget.WifiScanner.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/charcoal_interactive</item>
        <item name="android:textColor">@color/charcoal_text_states</item>
    </style>

    <style name="Toolbar.WifiScanner" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brand</item>
        <item name="titleTextColor">@color/text_on_brand</item>
        <item name="subtitleTextColor">@color/text_on_brand</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
